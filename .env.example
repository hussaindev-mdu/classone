# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form enquiries are delivered (the owner's inbox).
CONTACT_TO_EMAIL=owner@example.com

# Where careers applications (with resume attached) are delivered.
# Defaults to the site's main email (info@) when empty.
CAREERS_TO_EMAIL=info@class1consulting.com

# Optional: verified sender on your Resend domain. Until your domain is
# verified you can use Resend's test sender "onboarding@resend.dev".
CONTACT_FROM_EMAIL="ClassOne Website <website@classoneconsulting.in>"

# Optional: absolute site URL used for metadata, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.classoneconsulting.in

# ---------------------------------------------------------------------------
# GitHub Pages (static export) only — there is no server, so the contact form
# posts to Web3Forms instead of /api/contact. Get a free access key at
# https://web3forms.com (it is tied to the owner's inbox and is public by
# design). In CI this comes from the WEB3FORMS_ACCESS_KEY repository secret.
# The careers form uploads resumes as attachments, which requires a Web3Forms
# PRO key. Register the key with info@class1consulting.com so submissions
# land there.
NEXT_PUBLIC_WEB3FORMS_KEY=
